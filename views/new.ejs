<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Message | CORE_NODE</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-dark: #0a0b1e;
            --bg-card: #16183d;
            --accent-primary: #7c4dff;
            --accent-secondary: #00e5ff;
            --text-main: #ffffff;
            --text-muted: #b0b3d6;
            --input-bg: rgba(0, 0, 0, 0.3);
            --border-light: rgba(255, 255, 255, 0.1);
        }

        @keyframes popIn {
            0% { opacity: 0; transform: scale(0.9) translateY(20px); }
            70% { transform: scale(1.02) translateY(-5px); }
            100% { opacity: 1; transform: scale(1) translateY(0); }
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        body {
            background-color: var(--bg-dark);
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            background: radial-gradient(circle at top left, rgba(124, 77, 255, 0.1), transparent 40%),
                        radial-gradient(circle at bottom right, rgba(0, 229, 255, 0.1), transparent 40%);
            animation: fadeIn 0.6s ease-out;
        }

        .form-container {
            background-color: var(--bg-card);
            border: 1px solid var(--border-light);
            padding: clamp(20px, 5vw, 40px);
            border-radius: 30px;
            width: 100%;
            max-width: 480px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
            margin: 20px;
            animation: popIn 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) both;
        }

        h3 {
            font-weight: 800;
            margin-bottom: 25px;
            text-transform: uppercase;
            letter-spacing: -1px;
            background: linear-gradient(135deg, #fff 30%, var(--accent-secondary) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: inline-block;
            border-bottom: 3px solid var(--accent-primary);
            padding-bottom: 5px;
            transition: 0.3s;
        }

        .form-label {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-bottom: 8px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .custom-input {
            background-color: var(--input-bg);
            border: 1px solid var(--border-light);
            border-radius: 12px;
            color: #fff;
            padding: 14px 16px;
            width: 100%;
            margin-bottom: 20px;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            font-weight: 600;
        }

        .custom-input:focus {
            outline: none;
            border-color: var(--accent-primary);
            background-color: rgba(0, 0, 0, 0.5);
            box-shadow: 0 0 0 4px rgba(124, 77, 255, 0.2);
            transform: scale(1.02);
        }

        .custom-input::placeholder {
            color: #555c82;
            font-weight: 400;
        }

        textarea.custom-input {
            min-height: 100px;
            resize: none;
        }

        .btn-create {
            background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
            color: #fff;
            font-weight: 800;
            border: none;
            padding: 16px;
            border-radius: 14px;
            width: 100%;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 0.9rem;
        }

        .btn-create:hover {
            transform: translateY(-5px) scale(1.02);
            box-shadow: 0 15px 30px rgba(124, 77, 255, 0.4);
            color: #fff;
        }

        .back-link {
            display: block;
            text-align: center;
            margin-top: 20px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 600;
            transition: 0.3s;
        }

        .back-link:hover {
            color: var(--accent-secondary);
            transform: translateY(-2px);
        }

        @media (max-width: 576px) {
            .form-container {
                border-radius: 20px;
                padding: 25px;
            }
        }
    </style>
</head>
<body>

    <div class="container d-flex justify-content-center">
        <div class="form-container">
            <h3>New Message</h3>

            <form action="/chats" method="POST">
                
                <div class="mb-1" style="animation: fadeIn 0.5s ease-out 0.2s both;">
                    <label class="form-label">Initiator</label>
                    <input type="text" placeholder="Access ID" name="from" class="custom-input" required />
                </div>

                <div class="mb-1" style="animation: fadeIn 0.5s ease-out 0.3s both;">
                    <label class="form-label">Recipient</label>
                    <input type="text" placeholder="Target ID" name="to" class="custom-input" required />
                </div>

                <div class="mb-1" style="animation: fadeIn 0.5s ease-out 0.4s both;">
                    <label class="form-label">Data Payload</label>
                    <textarea name="msg" class="custom-input" placeholder="Enter secure message..." required></textarea>
                </div>

                <div style="animation: fadeIn 0.5s ease-out 0.5s both;">
                    <button type="submit" class="btn-create">Execute Send</button>
                    <a href="/chats" class="back-link">Return to Terminal</a>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>